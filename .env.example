# =============================================================================
# Rent-Ruby / Gumption by Silverback AI — environment variables
# =============================================================================
# Copy this file to `.env.local` (gitignored) and fill in the values.
# Anything prefixed with `VITE_` is exposed to the browser bundle at build time.

# -----------------------------------------------------------------------------
# Gemini AI
# -----------------------------------------------------------------------------
# Required for Gemini AI API calls.
# In AI Studio this is auto-injected at runtime from user secrets via the
# Secrets panel. For local dev / self-hosted deploys, set it explicitly.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio auto-injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# Firebase Web App config
# -----------------------------------------------------------------------------
# These values OVERRIDE firebase-applet-config.json at runtime when present.
# Leave them unset to keep using the AI Studio default project
# (`gen-lang-client-0013150741`) — useful for local dev with no setup.
#
# To deploy against the `samantha-gumption` project:
#   1. In Firebase console → samantha-gumption → Project Settings → Add Web App
#   2. Copy the generated `firebaseConfig` values into the entries below
#   3. (Optional) Create a non-default Firestore database and put its ID in
#      VITE_FIREBASE_FIRESTORE_DATABASE_ID, OR leave blank to use `(default)`
#      (in which case also clear `firestoreDatabaseId` in the fallback JSON).
#
# Firebase Web API keys are PUBLIC identifiers (see
# https://firebase.google.com/docs/projects/api-keys) — access is gated by
# Firestore/Storage security rules + App Check, not by the apiKey value.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
