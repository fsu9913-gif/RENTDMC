rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: userSettings
    // Document ID: {uid}
    // Fields:
    //   - uid: string (required) - User's Firebase Auth UID
    //   - unit: string (required) - Tenant's unit number
    //   - mailboxColor: string (optional) - Hex color code
    //   - preferred_notification_time: string (optional)
    //   - sms_enabled: bool (optional)
    //   - email_enabled: bool (optional)
    //
    // Collection: mailboxCustomizations
    // Document ID: {unit}
    // Fields:
    //   - unit: string (required) - Unit number
    //   - color: string (required) - Hex color code
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "admin@mobilecarbsmoketest.com" && request.auth.token.email_verified == true));
    }

    function isValidColor(color) {
      return color is string && color.matches("^#[0-9A-Fa-f]{6}$");
    }

    function isValidUserSettings(data) {
      return data.keys().hasAll(['uid', 'unit']) &&
             data.uid is string &&
             data.unit is string &&
             (!('mailboxColor' in data) || isValidColor(data.mailboxColor));
    }

    function isValidMailboxCustomization(data) {
      return data.keys().hasAll(['unit', 'color']) &&
             data.unit is string &&
             isValidColor(data.color);
    }

    function isValidEmail(email) {
      return email is string &&
             email.matches("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$") &&
             email.size() <= 254;
    }

    function isValidUnit(unit) {
      // 3-digit unit numbers like 101..108, 201..206, 301..306.
      return unit is string && unit.matches("^[1-3][0-9]{2}$");
    }

    function isValidTenantSubscription(data, unitId) {
      return data.keys().hasAll(['unit', 'email', 'notifications']) &&
             // Hard rule from product: this collection never stores a tenant name.
             !('name' in data) &&
             !('first_name' in data) &&
             !('last_name' in data) &&
             !('full_name' in data) &&
             isValidUnit(data.unit) &&
             data.unit == unitId &&
             isValidEmail(data.email) &&
             data.notifications is map &&
             data.notifications.email is bool &&
             data.notifications.sms is bool &&
             data.notifications.push is bool &&
             (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 32));
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /userSettings/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && isValidUserSettings(request.resource.data);
      allow update: if isOwner(uid) && isValidUserSettings(request.resource.data);
    }

    match /mailboxCustomizations/{unit} {
      allow read: if true; // Publicly visible (anonymized)
      allow create, update: if isAuthenticated() && 
                             isValidMailboxCustomization(request.resource.data) &&
                             (isAdmin() || (get(/databases/$(database)/documents/userSettings/$(request.auth.uid)).data.unit == unit));
      allow delete: if isAdmin();
    }

    // tenantSubscriptions: one document per unit holding the resident's
    // chosen contact email/phone and notification channel preferences.
    // Anonymous create/update is allowed because the tenant landing page
    // does not require an account — the unit number is the login. The
    // schema validator above enforces "apartment number only, no name"
    // and rejects writes that try to smuggle a name field in.
    //
    // Reads are admin-only so a casual visitor can't enumerate tenant
    // emails by guessing unit numbers.
    match /tenantSubscriptions/{unit} {
      allow read: if isAdmin();
      allow create, update: if isValidUnit(unit) &&
                              isValidTenantSubscription(request.resource.data, unit);
      allow delete: if isAdmin();
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
